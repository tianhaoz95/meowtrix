{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowtrix Lite",
  "version": "1.19.2",
  "identifier": "sh.meowtrix.lite",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:9123",
    "beforeDevCommand": "npm start"
  },
  "app": {
    "windows": [
      {
        "title": "Meowtrix Lite",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tianhaoz95/meowtrix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNThCMTNFMkVCNjJDN0YKUldSL0xMWXVQckZZb1RCZjg5ZWtVNlZkditTYUR2TVNQcmt4cXNBZ0Q0cURucUVHRXhVK1pSQTAK"
    }
  }
}
